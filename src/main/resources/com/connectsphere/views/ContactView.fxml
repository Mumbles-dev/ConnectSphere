<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.connectsphere.controller.ContactFormController"
      stylesheets="@../stylesheets/Main.css" styleClass="form-root" prefWidth="440">

    <VBox spacing="2">
        <Label fx:id="formTitleLabel" text="Add Contact" styleClass="form-title"/>
        <Label text="Contact details and any people they already know." styleClass="form-subtitle"/>
    </VBox>

    <!-- Name / Phone / Email -->
    <VBox spacing="14">
        <VBox spacing="5">
            <Label text="NAME" styleClass="form-field-label"/>
            <TextField fx:id="nameField" promptText="Full name" styleClass="form-text-field"/>
        </VBox>
        <VBox spacing="5">
            <Label text="PHONE" styleClass="form-field-label"/>
            <TextField fx:id="phoneField" promptText="Phone number" styleClass="form-text-field"/>
        </VBox>
        <VBox spacing="5">
            <Label text="EMAIL" styleClass="form-field-label"/>
            <TextField fx:id="emailField" promptText="Email address" styleClass="form-text-field"/>
        </VBox>
        <Label fx:id="validationLabel" styleClass="form-validation-label" managed="false" visible="false"/>
    </VBox>

    <!-- Connections picker -->
    <VBox spacing="8">
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="CONNECT TO EXISTING CONTACTS" styleClass="form-section-label" HBox.hgrow="ALWAYS"/>
            <Label fx:id="selectedCountLabel" text="0 selected" styleClass="form-count-badge"/>
        </HBox>

        <TextField fx:id="connectionSearchField" promptText="Search contacts to connect…" styleClass="connection-search-field"/>

        <ListView fx:id="connectionsListView" styleClass="connection-list" prefHeight="200">
            <placeholder>
                <Label text="No other contacts yet." styleClass="empty-state-label"/>
            </placeholder>
        </ListView>
    </VBox>

    <!-- Buttons -->
    <HBox styleClass="form-button-row" alignment="CENTER_RIGHT" spacing="10">
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="cancelButton" text="Cancel" onAction="#onCancel" styleClass="form-cancel-button"/>
        <Button fx:id="saveButton" text="Add Contact" onAction="#onSave" styleClass="form-save-button"/>
    </HBox>

</VBox>
